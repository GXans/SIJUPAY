@model Usuario
@{
    ViewData["Title"] = "Index";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/css/login.css" rel="stylesheet" />
    <title>Acceso a SiJuPay </title>
</head>
<body>

    <div class="stage">

        <div class="robot-wrapper float-slow">
            <div class="bot-monitor">
                <div class="eye"><div class="pupil"></div></div>
                <div class="eye"><div class="pupil"></div></div>
            </div>
            <div class="bot-body-square"></div>
            <div style="font-size:10px; color:#00e5ff; margin-top:5px; letter-spacing:2px;">SYS.ADMIN</div>
        </div>

        <div class="login-card">
            <div>
                <h2>SIJUPAY</h2>
                <h2>LO MEJOR EN HARDWARE</h2>
                 
                <p style="text-align:center; color:#888; margin-top:5px;">Por favor ingresa tus credenciales</p>
            </div>

            <form asp-controller="Acceso" asp-action="Index" method="post" style="display:flex; flex-direction:column; gap:20px;">
                <input type="text" asp-for="Telefono" placeholder="ID de Usuario / Teléfono" required autocomplete="off">
                <input type="password" asp-for="Contrasena" placeholder="Contraseña" required>
                <button type="submit">Ingresar</button>
            </form>

            <div style="text-align:center; font-size:12px; color:#555;">
                ¿No tienes un usuario? <a href="/Acceso/Registro" style="color:#00e5ff; text-decoration:none;">Regístrate aquí</a>
            </div>
        </div>

        <div class="robot-wrapper float-fast">
            <div class="bot-sphere">
                <div class="eye"><div class="pupil"></div></div>
                <div class="eye"><div class="pupil"></div></div>
            </div>
            <div class="bot-body-round"></div>
            <div class="bot-base"></div>
            <div style="font-size:10px; color:#ff1744; margin-top:5px; letter-spacing:2px;">NET.GUARD</div>
        </div>

    </div>

    <script>
        const pupils = document.querySelectorAll('.pupil');

        document.addEventListener('mousemove', (e) => {
            pupils.forEach(pupil => {
                const rect = pupil.parentElement.getBoundingClientRect();

                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;

                const angle = Math.atan2(y, x);
                const distance = Math.min(8, Math.hypot(x, y) / 3.5);

                pupil.style.transform = `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px)`;
            });
        });
    </script>
</body>
</html>