@model SIJUPAY.Models.ViewModels.ReporteComprasViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using SIJUPAY.Models.ViewModels

@{
    ViewData["Title"] = "Reporte de Compras | Administrador";
    // El controlador de Compras ya serializa los datos
    var datosGraficoJson = ViewBag.DatosGraficoJson as string ?? "[]";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="main-content-card report-card">
    <div class="header-section">
        <h2 class="neon-title-report"><i class="fas fa-chart-bar"></i> Reporte de Compras y Gastos</h2>
        <p class="subtitle">Análisis detallado de transacciones de adquisiciones finalizadas.</p>
    </div>

    <hr class="neon-divider" />

    <form asp-action="Reporte" method="post" class="form-report-filter">
        <div class="row g-3 align-items-end">

            <div class="col-md-4">
                <label asp-for="IdProveedor" class="form-label-custom">Proveedor</label>
                <select asp-for="IdProveedor" class="form-control-custom"
                        asp-items="@(new SelectList(Model.ListaProveedores, "IdUsuario", "Nombre"))">
                    <option value="">-- Todos los Proveedores --</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="FechaInicio" class="form-label-custom">Fecha Inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control-custom" />
            </div>

            <div class="col-md-4">
                <label asp-for="FechaFin" class="form-label-custom">Fecha Fin</label>
                <input asp-for="FechaFin" type="date" class="form-control-custom" />
            </div>

            <div class="col-md-12 text-center mt-3">
                <button type="submit" class="btn-primary-action btn-sm">
                    <i class="fas fa-search"></i> Filtrar Reporte
                </button>
            </div>
        </div>
    </form>

    <div class="report-results-section mt-5">
        @if (Model.ResultadosCompras != null && Model.ResultadosCompras.Any())
        {
            <div class="row mb-5">
                <div class="col-md-8 mx-auto">
                    <div class="chart-container">
                        <h4 class="text-center neon-title-report-small">Distribución de Gasto Total por Proveedor</h4>
                        <canvas id="graficoCompras"></canvas>
                    </div>
                </div>
            </div>

            <div class="alert alert-success alert-neon text-center mt-4">
                <h4><i class="fas fa-money-bill-wave"></i> Gasto Total Consolidado: @Model.TotalCompras.ToString("C")</h4>
                <p>Mostrando @Model.ResultadosCompras.Count() compras en el periodo seleccionado.</p>
            </div>

            <h4 class="mt-5 mb-3 neon-title-report-small">Detalle de Compras (Resultados de la Búsqueda)</h4>
            <div class="table-responsive">
                <table class="table table-dark table-striped table-hover table-bordered table-report">
                    <thead class="bg-dark-neon">
                        <tr>
                            <th>ID Compra</th>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th>Total Gasto</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var compra in Model.ResultadosCompras)
                        {
                            <tr>
                                <td>@compra.IdCompra</td>
                                <td>@compra.IdProveedorNavigation.Nombre</td>
                                <td>@(compra.Fecha.HasValue ? compra.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                <td>@compra.Total.ToString("C")</td>
                                <td>
                                    <a asp-action="DetalleFactura" asp-route-id="@compra.IdCompra" class="btn btn-sm btn-info">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        }
        else
        {
            <div class="alert alert-warning text-center">
                No se encontraron resultados de compras que coincidan con los filtros seleccionados.
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        try {
            const datosGraficoJson = '@Html.Raw(datosGraficoJson)';
            const datos = JSON.parse(datosGraficoJson);

            if (datos && datos.length > 0) {
                const etiquetas = datos.map(d => d.Etiqueta);
                const valores = datos.map(d => d.Valor);

                // Colores adaptados para Compras
                const colores = [
                    'rgba(255, 99, 132, 0.6)',
                    'rgba(54, 162, 235, 0.6)',
                    'rgba(255, 206, 86, 0.6)',
                    'rgba(75, 192, 192, 0.6)',
                    'rgba(153, 102, 255, 0.6)',
                    'rgba(255, 159, 64, 0.6)'
                ];

                // Dibujar el Gráfico de Barras
                const ctx = document.getElementById('graficoCompras');

                new Chart(ctx, {
                    type: 'bar', // Tipo de gráfico: barras
                    data: {
                        labels: etiquetas,
                        datasets: [{
                            label: 'Gasto Total ($)',
                            data: valores,
                            backgroundColor: colores.slice(0, etiquetas.length),
                            borderColor: colores.slice(0, etiquetas.length).map(c => c.replace('0.6', '1')),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            title: {
                                display: true,
                                text: 'Total de Gasto por Proveedor'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Monto Total ($)'
                                }
                            }
                        }
                    }
                });
            }
        } catch (e) {
             console.error("Error al parsear datos del gráfico:", e);
        }
    </script>
}