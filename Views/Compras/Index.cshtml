@model IEnumerable<SIJUPAY.Models.Compra>

@{
    ViewData["Title"] = "Historial de Compras";
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-primary"> Historial de Compras</h1>
            <hr />

            <div class="d-flex justify-content-end mb-4">
                <a asp-action="Crear" class="btn btn-success">
                    <i class="fas fa-plus"></i> Registrar Nueva Compra
                </a>
            </div>

            @if (Model.Any())
            {
                <table class="table table-striped table-bordered table-hover">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>ID Compra</th>
                            <th>Fecha</th>
                            <th>Usuario/Proveedor</th>
                            <th>Total Pagado</th>
                            <th>Método de Pago</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdCompra</td>
                                <td>@(item.Fecha.HasValue? item.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                <td>@item.IdProveedorNavigation.Nombre @item.IdProveedorNavigation.Apellido</td>
                                <td>@item.Total.ToString("C")</td>
                                <td>@item.MetodoPago</td>
                                <td><span class="badge bg-success">@item.Observaciones</span></td>
                                <td>
                                    <a asp-action="DetalleFactura" asp-route-id="@item.IdCompra" class="btn btn-sm btn-info text-white">
                                        <i class="fas fa-file-invoice"></i> Ver Factura
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    No hay compras finalizadas registradas en el historial.
                </div>
            }
        </div>
    </div>
</div>
