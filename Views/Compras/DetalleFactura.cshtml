@model SIJUPAY.Models.Compra

@{
    ViewData["Title"] = $"Factura de Compra #{Model.IdCompra}";
}

<div class="container my-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0"> Factura de Compra No. @Model.IdCompra</h1>
        </div>
        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Detalles del Comprador</h5>
                    <p class="mb-1">
                        Usuario: @Model.IdProveedorNavigation.Nombre @Model.IdProveedorNavigation.Apellido
                    </p>
                    <p class="mb-1">
                        Teléfono: @Model.IdProveedorNavigation.Telefono
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5>Datos de la Compra</h5>
                    
                    <p class="mb-1">
                        Fecha: @(Model.Fecha.HasValue? Model.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                    </p>
                    <p class="mb-1">
                        Estado: @Model.Observaciones
                    </p>

                    
                    <p class="mb-1">
                        Método de Pago: <span class="badge bg-success">@Model.MetodoPago</span>
                    </p>
                </div>
            </div>

            <hr />

            <h5>Productos Adquiridos</h5>
            <table class="table table-striped table-bordered mt-3">
                <thead class="bg-light">
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.CompraDetalles)
                    {
                        <tr>
                            <td>@detalle.IdProductoNavigation.Nombre</td>
                            <td>@detalle.Cantidad</td>
                            <td>@detalle.PrecioUnitario.ToString("C")</td>
                            <td>@(detalle.Cantidad* detalle.PrecioUnitario)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row justify-content-end mt-4">
                <div class="col-md-4">
                    <div class="bg-light p-3 border rounded text-end">
                        <p class="fs-5 mb-0">Total General Pagado:</p>
                        <h2 class="text-primary">@Model.Total.ToString("C")</h2>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer text-center">
            <a asp-action="Crear" class="btn btn-primary">Nueva Compra</a>
        </div>
    </div>
</div>