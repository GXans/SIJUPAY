@model SIJUPAY.Models.Compra

@{
    ViewData["Title"] = $"Factura de Compra #{Model.IdCompra}";
}

<div class="main-content-card factura-card">

    <div class="factura-header">
        <h1 class="neon-title-factura">
            FACTURA DE COMPRA
            <span class="factura-id">No. @Model.IdCompra</span>
        </h1>
        <hr class="neon-divider" />
    </div>

    <div class="data-section">

        <div class="data-group cliente-data">
            <h5 class="group-title">Datos del Proveedor</h5>

            <p>
                <span class="data-label">Proveedor:</span>
                @Model.IdProveedorNavigation.Nombre @Model.IdProveedorNavigation.Apellido
            </p>

            <p>
                <span class="data-label">Teléfono:</span>
                @Model.IdProveedorNavigation.Telefono
            </p>
        </div>

        <div class="data-group venta-data">
            <h5 class="group-title">Datos de la Transacción</h5>

            <p>
                <span class="data-label">Fecha:</span>
                @(Model.Fecha.HasValue ? Model.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
            </p>

            <p>
                <span class="data-label">Estado:</span>
                <span class="badge-status">@Model.Observaciones</span>
            </p>

            <p>
                <span class="data-label">Método Pago:</span>
                <span class="badge-payment">@Model.MetodoPago</span>
            </p>
        </div>

    </div>

    <hr class="neon-divider" />

    <div class="detail-section">
        <h5 class="group-title">Productos Adquiridos</h5>

        <table class="futuristic-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio Unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.CompraDetalles)
                {
                    <tr>
                        <td>@detalle.IdProductoNavigation.Nombre</td>
                        <td class="text-center">@detalle.Cantidad</td>
                        <td class="text-end">@detalle.PrecioUnitario.ToString("C0")</td>
                        <td class="text-end total-row">
                            @((detalle.Cantidad * detalle.PrecioUnitario).ToString("C0"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="total-summary">
        <div class="total-box">
            <p class="total-label">Total General Pagado:</p>
            <h2 class="total-value">@Model.Total.ToString("C0")</h2>
        </div>
    </div>

    <div class="factura-footer">
        <a asp-action="Crear" class="btn-primary-action">
            <i class="fas fa-plus-circle"></i> Registrar Nueva Compra
        </a>

        <button onclick="window.print()" class="btn-secondary-action">
            <i class="fas fa-print"></i> Imprimir Factura
        </button>
    </div>

</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
