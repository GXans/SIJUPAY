@model SIJUPAY.Models.ViewModels.CompraViewModel

@{
    ViewData["Title"] = "Finalizar Compra Pendiente";

    int idCompraPendiente = ViewBag.IdCompraPendiente != null ? (int)ViewBag.IdCompraPendiente : 0;
    decimal subtotal = 0;
}

<div class="main-content-card factura-card" style="padding: 35px;">

    <div class="factura-header" style="margin-bottom: 35px;">
        <h1 class="neon-title-factura" style="margin-bottom: 10px;">
            CARRITO DE COMPRA
            <span class="factura-id">Compra Pendiente</span>
        </h1>
        <p class="text-center text-muted" style="font-size: 1.1rem; margin-bottom: 10px;">
            Revise los productos y seleccione un método de pago para finalizar.
        </p>
        <hr class="neon-divider" />
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center my-3">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Detalles.Any())
    {
        <div class="alert alert-info text-center my-4">
            El carrito de compras está vacío. Regrese al catálogo para agregar productos.
        </div>

        <div class="factura-footer" style="margin-top: 40px;">
            <a asp-action="Crear" class="btn-primary-action">
                <i class="fas fa-undo"></i> Volver al Catálogo
            </a>
        </div>
    }
    else
    {
        <form asp-action="FinalizarCompra" method="post" style="margin-top: 25px;">
            <input type="hidden" name="idCompra" value="@idCompraPendiente" />
            <input type="hidden" asp-for="IdProveedor" />

            <div class="data-section" style="gap: 40px; display: flex; flex-direction: column;">

                <!-- Tabla de productos -->
                <div class="data-group">
                    <h5 class="group-title" style="margin-bottom: 20px;">Productos en el Carrito</h5>

                    <table class="futuristic-table" style="margin-bottom: 40px;">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Costo Unitario</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Detalles)
                            {
                                decimal totalItem = item.Cantidad * item.PrecioCompra;
                                subtotal += totalItem;

                                <tr>
                                    <td>@item.NombreProducto</td>
                                    <td class="text-center">@item.Cantidad</td>
                                    <td class="text-end">$@item.PrecioCompra.ToString("N2")</td>
                                    <td class="text-end total-row">$@totalItem.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr class="neon-divider" style="margin: 10px 0 25px 0;" />

                <!-- Total -->
                <div class="total-summary" style="margin-bottom: 30px;">
                    <div class="total-box" style="padding: 20px 25px;">
                        <p class="total-label">TOTAL A PAGAR:</p>
                        <h2 class="total-value" style="font-size: 2rem;">$@subtotal.ToString("N2")</h2>
                    </div>
                </div>

                <!-- Método de pago -->
                <div class="detail-section" style="margin-top: 30px;">
                    <h5 class="group-title" style="margin-bottom: 15px;">Método de Pago</h5>

                    <div class="form-floating neon-input" style="margin-top: 15px;">
                        <select id="metodoDePago" name="metodoDePago" class="form-control" required>
                            <option value="">-- Seleccionar --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Credito">Crédito (A plazos)</option>
                        </select>
                        <label for="metodoDePago">Seleccione un método de pago</label>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="factura-footer" style="margin-top: 50px;">
                <a asp-action="Crear" class="btn-primary-action">
                    <i class="fas fa-undo"></i> Seguir Comprando
                </a>

                <button type="submit" class="btn-secondary-action">
                    <i class="fas fa-handshake"></i> Finalizar Compra
                </button>
            </div>
        </form>
    }
</div>

