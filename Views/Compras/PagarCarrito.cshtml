@model SIJUPAY.Models.ViewModels.CompraViewModel
@using SIJUPAY.Models.ViewModels;

@{
    ViewData["Title"] = "Pagar Carrito de Compras";
    
    int idCompraPendiente = ViewBag.IdCompraPendiente ?? 0;
    int index = 0; 
}

<h1 class="mb-4 text-success"> Carrito de Compras</h1>

<div class="card shadow border-success">
    <div class="card-header bg-success text-white">
        <h5>Ajustar Cantidades y Precios de Compra</h5>
    </div>
    
    <form asp-action="FinalizarCompra" method="post">
        @Html.AntiForgeryToken()
        
        @if (idCompraPendiente != 0)
        {
            <input type="hidden" name="idCompra" value="@idCompraPendiente" />
        }
        
        <div class="card-body">
            
            @if (Model != null && Model.Detalles.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 40%;">Producto</th>
                            <th style="width: 25%;">Cantidad</th>
                            <th style="width: 25%;">Precio de Compra</th>
                            <th style="width: 10%;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Detalles)
                        {
                            <tr>
                                <td>@item.NombreProducto</td>
                                <td>
                                    <input type="number" name="Detalles[@index].Cantidad" 
                                           class="form-control form-control-sm" 
                                           value="@item.Cantidad" min="1" required />
                                </td>
                                <td>
                                    <input type="number" name="Detalles[@index].PrecioCompra" 
                                           class="form-control form-control-sm" 
                                           value="@item.PrecioCompra.ToString("0.00")" min="0.01" step="0.01" required />
                                </td>
                                <td>
                                    @item.Subtotal.ToString("C")
                                </td>
                            </tr>
                            
                            <input type="hidden" name="Detalles[@index].IdProducto" value="@item.IdProducto" />
                            
                            { index++; }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    El carrito está vacío. <a asp-action="Crear">Regresar al Catálogo</a>.
                </div>
            }
        </div>
        <div class="row mb-4">
            <div class="col-md-6">
                <label for="metodoDePago" class="form-label">Seleccione metodo de pago</label>

                <select id="metodoDePago" name="metodoDePago" class="form-control" required>
                    <option value="">-- Seleccione uno --</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia Bancaria</option>
                    <option value="Credito">Tarjeta de Crédito</option>
                </select>

            </div>
        </div>

        @if (Model != null && Model.Detalles.Any())
        {
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Crear" class="btn btn-secondary">Continuar Agregando</a>
                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                    <i class="fas fa-hand-holding-usd"></i> Finalizar y Pagar Compra
                </button>
            </div>
        }
    </form>
</div>