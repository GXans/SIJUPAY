@model SIJUPAY.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles</h1>

<div>
    <h4>Producto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Foto)
        </dt>
        <dd class="col-sm-10">
            @* CAMBIO CRÍTICO: Muestra la imagen binaria *@
            @if (Model.Foto != null && Model.Foto.Length > 0)
            {
                var base64 = Convert.ToBase64String(Model.Foto);
                var imgsrc = string.Format("data:image/gif;base64,{0}", base64);
                <img src="@imgsrc" style="max-height: 200px; max-width: 200px;" alt="@Model.Nombre" class="img-thumbnail" />
            }
            else
            {
                <span>(No hay foto disponible)</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Precio)
        </dt>
        <dd class="col-sm-10">
            @* CAMBIO: Muestra el precio con formato de moneda *@
            @Html.DisplayFor(model => model.Precio, "C")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-10">
            @* CAMBIO: Muestra el estado como texto amigable *@
            @(Model.Estado.GetValueOrDefault() ? "Activo" : "Inactivo")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Stock)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>

        <dt class="col-sm-2">
            Categoría
        </dt>
        <dd class="col-sm-10">
            @* CAMBIO CRÍTICO: Muestra el NOMBRE de la categoría *@
            @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdProducto" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>