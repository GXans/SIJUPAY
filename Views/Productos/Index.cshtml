@model IEnumerable<SIJUPAY.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<h1 class="mb-4">Inventario de Productos</h1>
<form asp-action="Index" method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control"
               placeholder="Buscar..." value="@ViewBag.Search" />
    </div>

    <div class="col-md-4">
        <select name="categoria" class="form-control" asp-items="ViewBag.Categorias">
            <option value="">-- Todas las categorías --</option>
        </select>
    </div>

    <div class="col-md-4">
        <button class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success mb-4">Crear Nuevo Producto</a>
</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">

                
                @if (item.Foto != null && item.Foto.Length > 0)
                {
                    var base64 = Convert.ToBase64String(item.Foto);
                    var imgsrc = $"data:image/png;base64,{base64}";
                    <img src="@imgsrc" class="card-img-top" style="height: 220px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height: 220px;">
                        <span class="text-muted">Sin Foto</span>
                    </div>
                }

                <div class="card-body">
                    <h5 class="card-title">@item.Nombre</h5>

                    <p class="card-text">
                        <strong>Precio:</strong> @item.Precio.ToString("C") <br />

                        <strong>Categoría:</strong> @item.IdCategoriaNavigation.Nombre <br />

                        <strong>Stock:</strong> @item.Stock <br />

                        <strong>Estado:</strong>
                        @if (item.Estado == true)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </p>
                </div>

                
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn btn-primary btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdProducto" class="btn btn-info btn-sm text-white">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdProducto" class="btn btn-danger btn-sm">Eliminar</a>
                    </div>
                </div>

            </div>
        </div>
    }
</div>
