@model Producto
 


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-title">Editar Producto</h1>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Volver a la Lista
        </a>
    </div>

    <div class="card futuristic shadow-sm">
        <div class="card-header futuristic">
            <h5 class="mb-0">Información del Producto: @Model.Nombre</h5>
        </div>

        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdProducto" />

                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-title mb-3">Datos Generales</h6>

                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control dark" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdCategoria" class="form-label">Categoría</label>
                            <select asp-for="IdCategoria" class="form-control dark" asp-items="ViewBag.IdCategoria">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Estado" class="form-label">Estado del Producto</label>
                            <select asp-for="Estado" class="form-control dark">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" type="number" class="form-control dark" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control dark" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-title mb-3">Detalles y Multimedia</h6>

                        <div class="form-group mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control dark" rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 p-3 border rounded border-secondary">
                            <label class="form-label fw-bold">Gestión de Foto</label>

                            @if (Model.Foto != null && Model.Foto.Length > 0)
                            {
                                var base64 = Convert.ToBase64String(Model.Foto);
                                var imgsrc = string.Format("data:image/gif;base64,{0}", base64);
                                <div class="mb-2 text-center">
                                    <p class="mb-1 text-muted small">Foto Actual:</p>
                                    <img src="@imgsrc" class="img-preview rounded-circle img-thumbnail" alt="Foto de @Model.Nombre" />
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-1 text-center small">(No hay foto cargada actualmente)</div>
                            }

                            <label class="form-label mt-2">Subir Nueva Foto (Reemplazar)</label>
                            <input type="file" name="fotoCargada" class="form-control dark" />
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4 text-end">
                    <button type="submit" class="btn btn-primary btn-lg btn-primary-lg">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
