@model SIJUPAY.Models.ViewModels.VentaViewModel

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="main-content-card">
    <div class="header-section">
        <h2 class="neon-title"><i class="fas fa-desktop"></i> Catálogo de Hardware</h2>
        <p class="subtitle">Selecciona las unidades deseadas de la lista para finalizar tu compra.</p>
    </div>

    <hr class="neon-divider" />

    @* --- Mensajes de Éxito/Error --- *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-neon" role="alert">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-neon" role="alert">
            @TempData["Success"]
        </div>
    }

    <form asp-action="RegistrarVenta" method="post">

        @* --- Input Oculto de Cliente (si es fijo, puede ser oculto) --- *@
        <input type="hidden" asp-for="IdCliente" />

        <div class="payment-selection-box mb-4">
                    <select asp-for="MetodoPago" class="form-control-custom-payment" required>
                        <option value="" disabled selected>-- Elegir Método --</option>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                        <option value="Transferencia">Transferencia Electrónica</option>
                    </select>
                    <span asp-validation-for="MetodoPago" class="validation-message"></span>
                </div>

            <div class="product-grid">
                @for (int i = 0; i < Model.ItemsCatalogo.Count; i++)
                {
                    var item = Model.ItemsCatalogo[i];

                    @* Campos ocultos necesarios para el POST *@
                    <input type="hidden" asp-for="ItemsCatalogo[i].IdProducto" />
                    <input type="hidden" asp-for="ItemsCatalogo[i].Nombre" />
                    <input type="hidden" asp-for="ItemsCatalogo[i].Precio" />
                    <input type="hidden" asp-for="ItemsCatalogo[i].Stock" />

                    <div class="product-card">

                        <div class="product-image-container">
                            @if (item.ImagenUrl != null)
                            {
                                <img src="data:image/png;base64,@item.ImagenUrl" alt="@item.Nombre" class="product-image" />
                            }
                            else
                            {
                                <div class="placeholder-image"><i class="fas fa-hdd"></i> <span>Sin Imagen</span></div>
                            }
                        </div>

                        <div class="card-content">
                            <h5 class="product-title">@item.Nombre</h5>
                            <p class="product-price">Precio: @item.Precio.ToString("C0")</p>
                            <p class="product-stock">Stock Disponible: @item.Stock</p>

                            <div class="quantity-input-group mt-3">
                                <label asp-for="ItemsCatalogo[i].CantidadAComprar" class="quantity-label">
                                    Cant. a Comprar:
                                </label>
                                <input asp-for="ItemsCatalogo[i].CantidadAComprar"
                                       type="number"
                                       class="quantity-input"
                                       value="0"
                                       min="0"
                                       max="@item.Stock" />
                                <span asp-validation-for="ItemsCatalogo[i].CantidadAComprar" class="validation-message"></span>
                            </div>

                        </div>
                    </div>
                }
            </div>

            @if (!Model.ItemsCatalogo.Any())
            {
                <div class="empty-message">
                    <i class="fas fa-exclamation-triangle"></i> No hay productos disponibles para la compra en este momento.
                </div>
            }

            @* --- Botón de FINALIZAR COMPRA (para el formulario completo) --- *@
            <div class="action-footer">
                <button type="submit" class="btn-primary-action">
                    <i class="fas fa-money-check-alt"></i> FINALIZAR COMPRA
                </button>
            </div>
    </form>
</div>

@section Scripts {

    <script>
        // Script para resaltar tarjetas seleccionadas (opcional, pero útil para UX)
        document.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('change', function () {
                const card = this.closest('.product-card');
                const quantity = parseInt(this.value);

                if (quantity > 0) {
                    card.classList.add('selected');
                } else {
                    card.classList.remove('selected');
                }
            });
        });
    </script>

    @* Asegurarse de tener las validaciones activas *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}