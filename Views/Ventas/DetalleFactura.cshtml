@model SIJUPAY.Models.Venta

@{
    ViewData["Title"] = $"Factura de Venta #{Model.IdVenta}";
}

<div class="container my-5">
    <div class="card shadow">
        <div class="card-header bg-success text-white text-center">
            <h1 class="mb-0">💵 Factura de Venta No. @Model.IdVenta</h1>
        </div>
        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>**Detalles del Cliente**</h5>
                    <p class="mb-1">
                        **Cliente:** @Model.IdClienteNavigation.Nombre @Model.IdClienteNavigation.Apellido
                    </p>
                    <p class="mb-1">
                        **Teléfono:** @Model.IdClienteNavigation.Telefono
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5>**Datos de la Venta**</h5>
                    @* Manejo de fecha nullable *@
                    <p class="mb-1">
                        **Fecha:** @(Model.Fecha.HasValue? Model.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                    </p>
                    <p class="mb-1">
                        **Estado:** @Model.Observaciones
                    </p>
                    <p class="mb-1">
                        **Método de Pago:** <span class="badge bg-primary">@Model.MetodoPago</span>
                    </p>
                </div>
            </div>

            <hr />

            <h5>**Productos Vendidos**</h5>
            <table class="table table-striped table-bordered mt-3">
                <thead class="bg-light">
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.VentaDetalles)
                    {
                        <tr>
                            <td>@detalle.IdProductoNavigation.Nombre</td>
                            <td>@detalle.Cantidad</td>
                            <td>@detalle.PrecioUnitario.ToString("C")</td>
                            <td>@(detalle.Cantidad* detalle.PrecioUnitario).ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row justify-content-end mt-4">
                <div class="col-md-4">
                    <div class="bg-light p-3 border rounded text-end">
                        <p class="fs-5 mb-0">**Total General Cobrado:**</p>
                        <h2 class="text-success">@Model.Total.ToString("C")</h2>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer text-center">
            <a asp-action="Crear" class="btn btn-success">Regresar al catalogo</a>
        </div>
    </div>
</div>
