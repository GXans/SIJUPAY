@model SIJUPAY.Models.Venta

@{
    ViewData["Title"] = $"Factura de Venta #{Model.IdVenta}";
}

<div class="main-content-card factura-card">

    <div class="factura-header">
        <h1 class="neon-title-factura">
            FACTURA DE COMPRA
            <span class="factura-id">No. @Model.IdVenta</span>
        </h1>
        <hr class="neon-divider" />
    </div>

    <div class="data-section">

        <div class="data-group cliente-data">
            <h5 class="group-title"> Datos del Cliente</h5>
            <p>
                <span class="data-label">Cliente:</span> @Model.IdClienteNavigation.Nombre @Model.IdClienteNavigation.Apellido
            </p>
            <p>
                <span class="data-label">Teléfono:</span> @Model.IdClienteNavigation.Telefono
            </p>
        </div>

        <div class="data-group venta-data">
            <h5 class="group-title"> Datos de la Compra</h5>
            <p>
                <span class="data-label">Fecha:</span> @(Model.Fecha.HasValue? Model.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
            </p>
            <p>
                <span class="data-label">Estado:</span> <span class="badge-status">@Model.Observaciones</span>
            </p>
            <p>
                <span class="data-label">Método Pago:</span> <span class="badge-payment">@Model.MetodoPago</span>
            </p>
        </div>

    </div>

    <hr class="neon-divider" />

    <div class="detail-section">
        <h5 class="group-title"> Detalles de la Compra</h5>

        <table class="futuristic-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio Unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.VentaDetalles)
                {
                    <tr>
                        <td>@detalle.IdProductoNavigation.Nombre</td>
                        <td class="text-center">@detalle.Cantidad</td>
                        <td class="text-end">@detalle.PrecioUnitario.ToString("C0")</td>
                        <td class="text-end total-row">@((detalle.Cantidad * detalle.PrecioUnitario).ToString("C0"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="total-summary">
        <div class="total-box">
            <p class="total-label">Total General Cobrado:</p>
            <h2 class="total-value">@Model.Total.ToString("C0")</h2>
        </div>
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <div class="factura-footer">
            <a asp-action="Reporte" class="btn-primary-action">
                <i class="fas fa-undo">Regresar </i>
            </a>
            <button onclick="window.print()" class="btn-secondary-action">
                <i class="fas fa-print">Imprimir Factura</i>
            </button>
        </div>
    }
    else
    {


    <div class="factura-footer">
        <a class="btn-primary-action" asp-action="Crear">
            <i class="fas fa-undo">Regresar </i>
        </a>
        <button onclick="window.print()" class="btn-secondary-action">
            <i class="fas fa-print">Imprimir Factura</i>
        </button>
    </div>
    }

</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}